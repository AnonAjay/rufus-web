{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rufus",
  "version": "0.1.0",
  "identifier": "com.rufus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rufus Desktop Assistant",
        "width": 1080,
        "height": 720,
        "minWidth": 600,
        "minHeight": 450,
        "decorations": false,
        "alwaysOnTop": false,
        "transparent": false
      },
      {
        "label": "capsule",
        "title": "Rufus Island",
        "url": "index.html?view=capsule",
        "width": 420,
        "height": 48,
        "minWidth": 120,
        "minHeight": 36,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
